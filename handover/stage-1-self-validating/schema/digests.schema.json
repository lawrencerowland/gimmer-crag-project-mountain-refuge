{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/handover-digests.schema.json",
  "title": "Handover evidence digests",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "evidence_dir",
    "digests"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_dir": {
      "type": "string"
    },
    "digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}

